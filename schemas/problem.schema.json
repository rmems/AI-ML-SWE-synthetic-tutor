{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmems/AI-ML-SWE-synthetic-tutor/schemas/problem.schema.json",
  "title": "Problem",
  "description": "One generated problem with its answer and generator provenance. A problem without a verification block is a candidate; only verified problems may be used in dataset rows. Mirrors tutor_schema::Problem.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_id", "topic", "generator", "statement", "parameters", "difficulty", "answer", "steps", "misconception_ids"],
  "properties": {
    "schema_version": { "const": 1 },
    "problem_id": { "type": "string", "minLength": 1 },
    "topic": {
      "description": "Curriculum topic ID (provisional until the coverage matrix, issue #16, fixes the ID list).",
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "generator": { "$ref": "#/$defs/generator" },
    "statement": { "type": "string", "minLength": 1 },
    "parameters": { "$ref": "#/$defs/parameters" },
    "difficulty": { "$ref": "#/$defs/difficulty" },
    "answer": { "$ref": "#/$defs/answer" },
    "steps": {
      "description": "Worked solution steps, machine-replayable: a verifier recomputes each step's output from its inputs and checks that every input traces to a declared parameter or an earlier step's output. The final step's value is the claimed answer.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/step" }
    },
    "misconception_ids": {
      "description": "Taxonomy IDs (from schemas/taxonomy.yaml) of the misconceptions this problem can carry.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "enum": [
        "algebra.distribution_error", "algebra.exponent_rule", "algebra.like_terms",
        "algebra.sign_error", "derivatives.chain_rule", "derivatives.implicit_differentiation",
        "derivatives.power_rule_overgeneralised", "derivatives.product_rule",
        "derivatives.quotient_rule", "functions.composition_order", "functions.domain_range",
        "functions.inverse_not_reciprocal", "integrals.antiderivative_exponent",
        "integrals.constant_of_integration", "integrals.setup_confusion",
        "limits.divide_by_zero_form", "limits.infinity_indeterminate_form",
        "limits.one_sided_limit", "trig.identity_confusion", "trig.unit_circle"
      ] }
    },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "language", "runtime_version", "seed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "language": { "enum": ["julia", "rust"] },
        "runtime_version": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "difficulty": {
      "description": "Ranges the parameters were drawn from; max_degree bounds each drawn polynomial's degree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_degree", "coefficient_bound", "point_bound"],
      "properties": {
        "max_degree": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "coefficient_bound": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "point_bound": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "coefficients": {
      "description": "Integer coefficients in ascending order of power; the last (leading) one must be nonzero.",
      "type": "array",
      "items": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
      "minItems": 1,
      "maxItems": 16
    },
    "parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "coefficients", "point"],
          "properties": {
            "kind": { "const": "polynomial_derivative_at_point" },
            "coefficients": { "$ref": "#/$defs/coefficients" },
            "point": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "a", "m", "b", "n", "point"],
          "properties": {
            "kind": { "const": "binomial_derivative_at_point" },
            "a": { "description": "Coefficient of the x^m term; nonzero.", "type": "integer", "not": { "const": 0 } },
            "m": { "description": "Leading exponent; must exceed n and be below 16.", "type": "integer", "minimum": 1, "maximum": 15 },
            "b": { "description": "Coefficient of the x^n term; nonzero.", "type": "integer", "not": { "const": 0 } },
            "n": { "description": "Lower exponent.", "type": "integer", "minimum": 0, "maximum": 14 },
            "point": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "p", "q", "point"],
          "properties": {
            "kind": { "const": "product_rule_at_point" },
            "p": { "$ref": "#/$defs/coefficients" },
            "q": { "$ref": "#/$defs/coefficients" },
            "point": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outer", "inner", "point"],
          "properties": {
            "kind": { "const": "chain_rule_at_point" },
            "outer": { "$ref": "#/$defs/coefficients" },
            "inner": { "$ref": "#/$defs/coefficients" },
            "point": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        }
      ]
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "input", "output"],
          "properties": {
            "kind": { "const": "differentiate_polynomial" },
            "input": { "$ref": "#/$defs/coefficients" },
            "output": { "$ref": "#/$defs/coefficients" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "coefficients", "point", "value"],
          "properties": {
            "kind": { "const": "evaluate_polynomial" },
            "coefficients": { "$ref": "#/$defs/coefficients" },
            "point": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "factors", "value"],
          "properties": {
            "kind": { "const": "multiply" },
            "factors": {
              "type": "array",
              "items": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
              "minItems": 2,
              "maxItems": 16
            },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "addends", "value"],
          "properties": {
            "kind": { "const": "add" },
            "addends": {
              "type": "array",
              "items": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
              "minItems": 2,
              "maxItems": 16
            },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verifier", "verifier_version"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "verifier_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
